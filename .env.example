# =============================================================================
# .env.example - configuration template for the Excel Clone backend
# =============================================================================
# Sections A to C are the complete list of configuration keys the backend reads. Copy it
# to `.env` in the repository root and edit the copy:
#
#     cp .env.example .env
#
# Every value below is a placeholder. Replace each one with a value for the
# environment you are configuring; none of them works as supplied.
#
# The keys must reach the process environment. Any of these does that:
#
#     PYTHONPATH=. uvicorn --env-file .env backend.app.main:app
#     set -a; . ./.env; set +a                   # bash or zsh, see the caveat below
#     an env / envFrom entry on the Kubernetes pod spec
#
# Do NOT use `export $(grep -v '^#' .env | xargs)`. `xargs` strips the quoting that
# ALLOWED_ORIGINS needs and word-splits on the spaces inside a JSON array, so the value
# reaches Pydantic malformed and validation fails. `uvicorn --env-file` parses the file
# itself and is the reliable option. If you dot-source instead, single-quote every JSON
# value in `.env` - ALLOWED_ORIGINS='["http://localhost:3000"]' - because the shell
# otherwise removes the inner double quotes and the JSON no longer parses.
#
# Do NOT commit `.env`. It holds SECRET_KEY and the DATABASE_URL password, and
# this repository has NO root `.gitignore`, so a populated `.env` appears in
# `git status` and is staged by `git add -A`. Check `git status` before every
# commit and never add `.env`.
#
# `Settings` in `backend/app/core/config.py` is the source of truth for the key
# names and types below; this file mirrors it. `Settings` uses Pydantic v1, which
# matches environment variable names case-insensitively, so an upper-case variant
# of a lower-case key below also resolves.
#
# ONE CANONICAL INPUT SET
# -----------------------
# Several keys below are the same fact as a Terraform variable and a frontend build
# variable. A deployment is coherent only when all three agree, and divergence does
# not fail loudly - it surfaces as refused sign-ins, CORS rejections, or a
# Content-Security-Policy that blocks every API call.
#
#   This file (backend)     infrastructure/terraform/variables.tf   frontend/.env
#   ---------------------   ------------------------------------    ------------------------------
#   PROJECT_ID              project_id                              REACT_APP_FIREBASE_PROJECT_ID
#   ALLOWED_ORIGINS         allowed_origins                         -
#   api_origin              api_origin                              origin of REACT_APP_API_BASE_URL
#   csp_report_only         csp_report_only                         -
#   signer_service_account  signer_service_account                  -
#   -                       domain_name                             -
#
# domain_name has no counterpart here, but it is not independent: the managed
# certificate serves it, so Terraform refuses to plan unless it is the host of an
# entry in allowed_origins. Keep ALLOWED_ORIGINS equal to the Terraform
# allowed_origins list and that check is satisfied automatically.
# The Terraform validations and the validators in config.py accept the same grammar
# on purpose: exact scheme://host[:port] origins, https except for loopback, and
# database TLS modes that cannot negotiate plaintext.

# =============================================================================
# SECTION A - Core settings (REQUIRED, no defaults)
# =============================================================================
# All six are required. `Settings` declares them without defaults, so a missing
# key raises a Pydantic ValidationError at import and the application does not
# start.

# The Google Cloud project ID. Used to build the Secret Manager resource path.
PROJECT_ID=your-gcp-project-id

# SQLAlchemy connection URL for Cloud SQL PostgreSQL 13.
# REQUIRED FOR VALIDATION EVEN THOUGH IT IS OVERWRITTEN: `Settings.__init__` calls
# `super().__init__()` first, so Pydantic validates this key BEFORE the value is
# replaced by the DATABASE_URL secret from Secret Manager. Omitting it fails startup.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/main-database

# Celery broker and result backend.
# Same overwrite caveat as DATABASE_URL: validated first, then replaced by the
# REDIS_URL secret. It must be present.
REDIS_URL=redis://localhost:6379/0

# HMAC signing key for the retained `create_access_token` helper. The live
# authentication path verifies Firebase ID tokens and does not use this key.
# Same overwrite caveat as DATABASE_URL: validated first, then replaced by the
# SECRET_KEY secret. It must be present.
SECRET_KEY=replace-me-with-a-long-random-string

# JWT signing algorithm for `create_access_token`. Not overwritten.
ALGORITHM=HS256

# Lifetime in minutes of a token minted by `create_access_token`. Not overwritten.
# This setting is now honoured; it was previously declared and never read.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# =============================================================================
# SECTION B - Security settings (OPTIONAL, each has a default in config.py)
# =============================================================================

# SECURITY: explicit CORS origin allow-list - the origin policy was previously
# unresolvable. Never set this to ["*"].
# MUST BE A JSON ARRAY. Pydantic v1 parses a List[str] field from the environment
# as JSON, so a bare comma-separated string fails with a parse error. Include
# every origin the browser uses: local development, staging and production.
ALLOWED_ORIGINS=["http://localhost:3000"]

# Cloud Storage bucket holding user uploads. Terraform names it
# `${project_id}-user-uploads`.
# The key is lower-case: `backend/app/services/file_storage.py` reads
# `get_settings().gcs_bucket_name` with this exact spelling.
gcs_bucket_name=your-gcp-project-id-user-uploads

# SECURITY: bounds every object-access grant - upload URLs were public and
# permanent. Lifetime in minutes of each generated V4 signed URL.
# Range 1..10080. 10080 minutes is seven days, the longest lifetime the Cloud
# Storage V4 signing scheme accepts; a value outside the range is rejected at
# construction rather than at the first signing attempt.
signed_url_expiry_minutes=15

# SECURITY: names the dedicated service account that signs object URLs - the
# signing identity was declared only in Terraform and never reached the
# application. Leave empty to sign with the runtime's own attached identity.
# When set it MUST equal the Terraform signer_service_account variable, and the
# format is validated at construction.
signer_service_account=excel-app-url-signer@your-gcp-project-id.iam.gserviceaccount.com

# SECURITY: database transport mode - the connection previously had no TLS
# setting. Values: require | verify-ca | verify-full, and nothing else.
# psycopg2's disable, allow and prefer modes are REJECTED at construction, because
# each can complete the connection without encryption; supplying one fails start-up
# rather than connecting in plaintext. verify-ca and verify-full additionally need
# certificate material reachable by the client. Cloud SQL is provisioned
# ENCRYPTED_ONLY, so the server refuses an unencrypted connection regardless.
db_sslmode=require

# SECURITY: selects the server-side token verification path - client-asserted
# identity was never verified. Values: firebase | legacy_jwt.
# Read per request, so a change takes effect on the next request with no restart.
auth_token_verifier=firebase

# SECURITY: authentication enforcement switch - previously no route required a
# valid token. BREAK-GLASS ONLY. When false, route authentication is bypassed and
# every endpoint is reachable without a token; each bypass is logged and marked on
# the response. Leave this true in every environment.
auth_enforcement_enabled=true

# SECURITY: master switch for both throttling tiers - no route was rate limited.
rate_limit_enabled=true

# SECURITY: global per-client request ceiling - request volume was unbounded.
# A window expression such as 600/minute. Must be generous: the cell-update
# endpoint fires on every edit and is covered by this ceiling.
rate_limit_default=600/minute

# SECURITY: tighter ceiling for POST, PUT, PATCH and DELETE - write volume was
# unbounded. Must still allow normal cell-editing and autosave cadence.
rate_limit_write=120/minute

# SECURITY: shared throttling window store - per-process counters let a client's
# effective quota multiply by the number of uvicorn workers and pods serving the
# API, so the configured ceiling was not the ceiling clients actually got.
# Leave empty to derive the store from REDIS_URL (Section A), which is the
# deployed configuration. Set "memory://" to count in process memory instead;
# that is correct only for a single-process local run. If the store is
# unreachable at startup the module logs a warning and falls back to process
# memory rather than refusing to serve.
rate_limit_storage_uri=

# SECURITY: number of trailing proxy hops whose forwarded client address is
# trusted. 0 uses the socket peer address only, so an X-Forwarded-For header
# cannot be spoofed. Behind the Google global load balancer set this to 1: the
# balancer appends its own address, making the real client the second-to-last
# entry. A value larger than the real hop count lets a client forge its identity
# and escape its own quota; a value of 0 behind a proxy collapses every client
# onto the balancer's egress address and throttles them as one.
rate_limit_trusted_proxy_hops=0

# SECURITY: Content-Security-Policy enforcement mode - no CSP was emitted on any
# response. When true the policy is sent as Content-Security-Policy-Report-Only,
# which reports violations without blocking. Read when middleware is constructed,
# so a change needs a process or pod restart.
csp_report_only=false

# SECURITY: restricts token verification to a single Firebase project - the issuer
# was unconstrained. The Firebase / Identity Platform project ID.
# Leave empty to pin verification to PROJECT_ID from Section A:
# `backend/app/core/security.py` resolves `firebase_project_id or PROJECT_ID` and
# always passes the result to the Admin SDK as an explicit `projectId` option, so
# GOOGLE_CLOUD_PROJECT is NOT consulted for this setting. Set it only when the
# Firebase project differs from PROJECT_ID.
firebase_project_id=your-firebase-project-id

# SECURITY: admits the API to the Content-Security-Policy connect-src allow-list -
# the policy admitted no cross-origin API, so a browser enforcing it blocked every
# API call. Leave empty when one edge origin serves both the SPA and the API,
# which 'self' already covers.
# Its ORIGIN - scheme://host[:port] and nothing more - must equal the Terraform
# api_origin variable, the container's CSP_CONNECT_SRC_API value and the origin of
# the frontend's REACT_APP_API_BASE_URL (Section E). Validated at construction.
api_origin=https://api.example.com

# =============================================================================
# SECTION C - Google Cloud client library variables (NOT `Settings` fields)
# =============================================================================
# These are read directly from the process environment by the Google Cloud client
# libraries and the Firebase Admin SDK. They are not declared on `Settings` and
# never appear in `Settings.__fields__`.

# How the Firebase Admin SDK and the Google Cloud clients resolve the project when
# no explicit option and no service-account key are supplied. Set automatically on
# Google infrastructure such as GKE; set it manually for local development.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to a local service-account key file, for Application Default Credentials
# during LOCAL DEVELOPMENT ONLY. No key file is required or shipped in the
# deployed container, which uses the runtime's attached identity.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-service-account-key.json

# =============================================================================
# SECTION D - Operator provisioning checklist
# =============================================================================
# These are operator actions, not values to fill in. Each one is a deployment
# blocker.
#
# 1. Create the three Secret Manager secrets DATABASE_URL, REDIS_URL and
#    SECRET_KEY in project PROJECT_ID, each with a `latest` version. This
#    repository creates no secrets. The application reads all three on every
#    `Settings()` construction and fails if any is absent.
#
# 2. Bind `roles/iam.serviceAccountTokenCreator` ON the dedicated signer service
#    account TO the API runtime service account, and make the runtime account
#    reachable from the pod through GKE Workload Identity, BEFORE deploying the
#    signed-URL code path. `infrastructure/terraform/main.tf` declares both
#    (google_service_account_iam_member.url_signer_token_creator and
#    .api_runtime_workload_identity); the variables signer_service_account,
#    runtime_service_account, kubernetes_namespace and kubernetes_service_account
#    must match the deployed pod spec. Without this, signed-URL generation fails
#    under Application Default Credentials with a missing-private-key error. Also
#    enable the IAM Service Account Credentials API in the project.
#
# 3. Keep ALLOWED_ORIGINS consistent with the Identity Platform authorized-domains
#    list in `infrastructure/terraform/main.tf`. If sign-in and CORS disagree about
#    which origins are legitimate, sign-in breaks.
#
# 4. Provision the managed SSL certificate and wait for it to report ACTIVE before
#    the edge forwarding rule cuts over to port 443. Managed certificates require
#    DNS validation and are not instantaneous.
# =============================================================================

# =============================================================================
# SECTION E - Frontend build-time variables (a DIFFERENT file, NOT `Settings`)
# =============================================================================
# These belong in `frontend/.env`, not in the backend `.env`. react-scripts inlines
# every REACT_APP_* variable into the compiled bundle at build time, so they are
# public by design and none of them is a secret. They are not `Settings` fields and
# never appear in `Settings.__fields__`.
#
# `frontend/src/services/api.ts` initialises the Firebase SDK from these values and
# throws, naming what is missing, when a required one is absent - so the browser
# cannot obtain an ID token and every API call fails.

# Base URL the browser calls the API at. Its ORIGIN - scheme://host[:port] and
# nothing more - must equal the api_origin Terraform variable and the container's
# CSP_CONNECT_SRC_API value, or the Content-Security-Policy blocks every API call.
REACT_APP_API_BASE_URL=https://api.example.com

# Firebase web configuration. The first four are REQUIRED by api.ts.
# REACT_APP_FIREBASE_PROJECT_ID must name the same project as the backend
# PROJECT_ID setting: a Firebase ID token names its issuing project in its aud and
# iss claims, so a token from another project is rejected.
REACT_APP_FIREBASE_API_KEY=your-firebase-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-gcp-project-id
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: the Auth SDK does not need either, and both are passed through as
# supplied.
REACT_APP_FIREBASE_STORAGE_BUCKET=your-gcp-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
# =============================================================================
