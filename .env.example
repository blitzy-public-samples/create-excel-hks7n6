# =============================================================================
# .env.example - configuration template for the Excel Clone backend
# =============================================================================
# Copy this file to `.env` in the repository root, then replace every value:
#
#     cp .env.example .env
#
# Every value in this file is a PLACEHOLDER. None of them work as supplied.
#
# Do NOT commit `.env`. This repository contains no .gitignore at any level, so
# a populated `.env` shows up as an untracked file and can be staged by
# accident. Check `git status` before every commit.
# -----------------------------------------------------------------------------
# How these keys are read
#
# The backend reads these through `Settings` in `backend/app/core/config.py`,
# which uses the Pydantic v1 `BaseSettings` API. Three consequences:
#
#   1. Key names match the `Settings` field names. Matching is case-insensitive,
#      so `gcs_bucket_name` and `GCS_BUCKET_NAME` both resolve to the same
#      field. The spellings below match the field declarations exactly.
#
#   2. List-typed keys are parsed as JSON. `ALLOWED_ORIGINS` must be a JSON
#      array. A bare comma-separated string fails at startup with
#      `SettingsError: error parsing env var "allowed_origins"`.
#
#   3. `get_settings()` builds a fresh `Settings` on every call. Keys consulted
#      inside a request path therefore take effect on the next request, while
#      keys consumed when middleware is constructed need a process or pod
#      restart.
#
# Keys marked REQUIRED have no default. Omitting any one of them raises a
# Pydantic `ValidationError` and the application does not start.
# =============================================================================


# =============================================================================
# SECTION B - Core settings (REQUIRED, no defaults)
# =============================================================================

# REQUIRED. Google Cloud project ID. Used to build the Secret Manager resource
# path `projects/<PROJECT_ID>/secrets/<NAME>/versions/latest`. Not overwritten
# at runtime.
PROJECT_ID=your-gcp-project-id

# REQUIRED. SQLAlchemy connection URL for the Cloud SQL PostgreSQL 13 database.
# Overwritten at startup from Secret Manager secret `DATABASE_URL`.
# It must still be set here: Pydantic validates before the secret is fetched, so
# omitting it raises `ValidationError` even though the value is then replaced.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/main-database

# REQUIRED. Celery broker and result backend URL.
# Overwritten at startup from Secret Manager secret `REDIS_URL`.
# It must still be set here, for the same reason as `DATABASE_URL` above.
REDIS_URL=redis://localhost:6379/0

# REQUIRED. HMAC signing key used by the `create_access_token` helper in
# `backend/app/core/security.py`. The live authentication path verifies Firebase
# ID tokens, so this key is used only by that retained token-issuing helper.
# Overwritten at startup from Secret Manager secret `SECRET_KEY`.
# It must still be set here, for the same reason as `DATABASE_URL` above.
SECRET_KEY=replace-me-with-a-long-random-string

# REQUIRED. JWT signing algorithm for `create_access_token`. Not overwritten at
# runtime.
ALGORITHM=HS256

# REQUIRED. Lifetime in minutes of tokens issued by `create_access_token`, used
# when the caller passes no explicit `expires_delta`. Not overwritten at
# runtime.
# SECURITY: token lifetime is now read from configuration - it was previously
# hardcoded and this setting was ignored.
ACCESS_TOKEN_EXPIRE_MINUTES=15


# =============================================================================
# SECTION C - Security settings (OPTIONAL, each has a default in config.py)
# =============================================================================
# These have defaults, so the application starts without them. The defaults are
# stated per key. Several must still be set for the application to work
# correctly against real infrastructure, as noted inline.
#
# Field names in this section are spelled exactly as declared in `Settings`.
# The code reads `gcs_bucket_name` and the other lower-case names in that form.
# Do not change their case.

# Optional, defaults to `[]` (an empty list, which allows no cross-origin
# request). Set this: with the default, the browser SPA is blocked by CORS.
# Must be a JSON array of exact origins, including scheme and port, and must
# cover local development, staging and production. `http://localhost:3000` is
# the frontend development server.
# SECURITY: explicit CORS allow-list - the origin policy was previously
# undeclared and unresolvable.
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional, defaults to `""`. Cloud Storage bucket holding user uploads.
# Set this: with the default, upload and download operations fail. Terraform
# names this bucket `<project_id>-user-uploads`.
gcs_bucket_name=your-gcp-project-id-user-uploads

# Optional, defaults to `15`. Lifetime in minutes of each generated V4 signed
# URL, which bounds how long any single object-access grant stays valid.
# SECURITY: upload URLs are time-limited - they were previously public and
# permanent.
signed_url_expiry_minutes=15

# Optional, defaults to `require`. Transport security mode for the PostgreSQL
# connection. Values: disable | allow | prefer | require | verify-ca |
# verify-full. `verify-ca` and `verify-full` additionally need CA material
# reachable by the client.
# SECURITY: database traffic is encrypted in transit - the connection was
# previously created with no TLS setting.
db_sslmode=require

# Optional, defaults to `firebase`. Selects the server-side token verification
# path. Values: firebase | legacy_jwt. Consulted per request, so a change takes
# effect on the next request with no restart.
# SECURITY: tokens are verified server-side - client-asserted identity was
# never checked.
auth_token_verifier=firebase

# Optional, defaults to `true`. Break-glass switch only. Setting this to `false`
# bypasses route authentication and leaves every endpoint reachable without a
# valid token; each bypassed request is logged and marked in the response. Keep
# this `true` in every environment, including local development.
# SECURITY: authentication is enforced on every route - previously no route
# required a valid token.
auth_enforcement_enabled=true

# Optional, defaults to `true`. Master switch for both throttling tiers below.
# SECURITY: request volume is bounded - no route was previously rate limited.
rate_limit_enabled=true

# Optional, defaults to `600/minute`. Global per-client request ceiling, as a
# `<count>/<window>` expression. Windows: second | minute | hour | day.
rate_limit_default=600/minute

# Optional, defaults to `120/minute`. Tighter per-client ceiling applied to
# POST, PUT, PATCH and DELETE, in the same `<count>/<window>` form. Cell edits
# and autosave both issue writes, so keep this above the write rate a user
# produces while typing; raise it if editing returns HTTP 429.
rate_limit_write=120/minute

# Optional, defaults to `false`. When `true`, Content-Security-Policy is sent as
# `Content-Security-Policy-Report-Only`, which reports violations without
# blocking. When `false`, the policy is enforced.
# SECURITY: a Content-Security-Policy is emitted - no CSP was previously sent on
# any response.
csp_report_only=false

# Optional, defaults to `""`. Firebase / Identity Platform project whose ID
# tokens are accepted. Set this: with the default, the accepted token issuer is
# unconstrained. Usually the same value as `PROJECT_ID`.
# SECURITY: token verification is restricted to a single project - the issuer
# was previously unconstrained.
firebase_project_id=your-firebase-project-id


# =============================================================================
# SECTION D - Google Cloud client library variables (NOT `Settings` fields)
# =============================================================================
# These are read by the Google Cloud client libraries and the Firebase Admin
# SDK directly, not through `Settings`. They are still required to run the
# backend locally.

# How the Firebase Admin SDK resolves the project when no explicit `projectId`
# option and no service-account key are supplied. Present automatically on
# Google infrastructure such as GKE; set it manually for local development.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Local development only. Absolute path to a service-account key file, used for
# Application Default Credentials. No key file is required or shipped in the
# deployed container, which uses the runtime's attached identity.
# If set, the path must point to an existing file: a placeholder path makes the
# client libraries fail to start. When authenticating with
# `gcloud auth application-default login`, delete this line.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json


# =============================================================================
# SECTION E - Operator provisioning checklist
# =============================================================================
# These are operator actions, not values to fill in above. Each one blocks
# deployment until it is done.
#
# 1. Create the Secret Manager secrets `DATABASE_URL`, `REDIS_URL` and
#    `SECRET_KEY` in project `PROJECT_ID`, each with a `latest` version. This
#    repository creates no secrets. The application reads all three on every
#    `Settings()` construction and fails when they are absent.
#
# 2. Grant `roles/iam.serviceAccountTokenCreator` to the dedicated signer
#    service account before deploying the signed-URL code path. Without it,
#    signed-URL generation fails under Application Default Credentials with a
#    missing-private-key error.
#
# 3. Keep `ALLOWED_ORIGINS` consistent with the Identity Platform
#    `authorized_domains` list in `infrastructure/terraform/main.tf`, which
#    currently holds the placeholder `["example.com"]`. When the two disagree,
#    sign-in and CORS accept different sets of origins.
#
# 4. Provision the managed SSL certificate and confirm it is ACTIVE before
#    cutting the edge forwarding rule over to port 443. Managed certificates
#    require DNS validation and are not immediate.
# -----------------------------------------------------------------------------
# Why any particular default was chosen is recorded in
# `documentation/Security Decision Log.md`.
# =============================================================================
