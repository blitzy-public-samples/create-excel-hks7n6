# Frontend container image: React build served by Nginx.
#
# BUILD CONTEXT: the REPOSITORY ROOT, not this directory and not frontend/. The image needs
# sources from two trees — frontend/ for the application and infrastructure/docker/ for the
# Nginx configuration — so every COPY below is relative to that root.
# Build with:
#   docker build -f infrastructure/docker/Dockerfile.frontend -t excel-app-frontend .
#
# Prerequisite: `npm ci` requires frontend/package-lock.json, which is not committed, and
# frontend/package.json does not declare every package the sources import. Both are
# pre-existing gaps, and the image cannot build until they are closed.

# Use an official Node.js runtime as the base image
FROM node:14 as build

# Set the working directory in the container
WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application code
COPY frontend/ ./

# Build the React application
RUN npm run build

# Use Nginx to serve the static files
FROM nginx:alpine

# Copy the built files from the build stage to Nginx's serve directory
COPY --from=build /app/build /usr/share/nginx/html

# SECURITY: install the Nginx security-header and SPA-routing configuration. This path
# previously served with default Nginx and no security headers, because the COPY was
# commented out. Installed as a template so the entrypoint renders the CSP_ variables into
# it before start.
COPY infrastructure/docker/nginx.conf /etc/nginx/templates/default.conf.template

# SECURITY: Content-Security-Policy delivery for the container-served application. These
# defaults produce the enforced same-origin policy, byte-identical to
# CONTENT_SECURITY_POLICY in backend/app/core/security_headers.py. Override
# CSP_HEADER_NAME with Content-Security-Policy-Report-Only to report without blocking, and
# CSP_CONNECT_SRC_API with a leading space and the API origin when a separate origin serves
# the API. NGINX_ENVSUBST_FILTER confines expansion to these two names, so the $uri
# references in the configuration reach nginx unchanged.
# The compiled document carries a meta policy of its own, but it deliberately names neither
# connect-src nor default-src, so it cannot constrain where the application connects and
# needs no build-time API origin. On this origin the connect-src allowance is therefore
# delivered by this response header alone.
ENV CSP_HEADER_NAME=Content-Security-Policy \
    CSP_CONNECT_SRC_API="" \
    NGINX_ENVSUBST_FILTER=^CSP_

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
